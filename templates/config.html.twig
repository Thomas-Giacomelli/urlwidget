{% import "components/form/fields_macros.html.twig" as fields %}

<div class="firstbloc">
    <table class="table card-table">
        <thead>
            <tr>
                <th>{{ __('Name') }}</th>
                <th>{{ __('URL') }}</th>
                <th>{{ __('JSON path', 'urlwidget') }}</th>
                <th>{{ __('Last value', 'urlwidget') }}</th>
                <th>{{ __('Cache (s)', 'urlwidget') }}</th>
                {% if can_edit %}<th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
            <tr>
                <td>{{ row.name }}</td>
                <td style="word-break: break-all;">{{ row.url }}</td>
                <td>{{ row.value_path }}</td>
                <td>
                    {{ row.value_prefix }}{{ row.cached_value }}{{ row.value_suffix }}
                    {% if row.cached_at %}<br><small class="text-muted">{{ row.cached_at }}</small>{% endif %}
                </td>
                <td>{{ row.cache_ttl }}</td>
                {% if can_edit %}
                <td>
                    <form method="post" action="{{ form_url }}">
                        <input type="hidden" name="id" value="{{ row.id }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" name="delete" value="1" class="btn btn-sm btn-ghost-danger"
                                onclick="return confirm('{{ __('Delete this entry?', 'urlwidget')|e('js') }}');">
                            <i class="ti ti-trash"></i>
                        </button>
                    </form>
                </td>
                {% endif %}
            </tr>
            {% else %}
            <tr>
                <td colspan="6">{{ __('No URL configured yet.', 'urlwidget') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if can_edit %}
<div class="firstbloc">
    <h3>{{ __('Add a new URL widget', 'urlwidget') }}</h3>
    <form method="post" action="{{ form_url }}" class="row g-2">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

        <div class="col-md-3">
            {{ fields.textField('name', '', __('Name'), {no_label: false}) }}
        </div>
        <div class="col-md-5">
            {{ fields.textField('url', '', __('Data URL (HTTP GET)', 'urlwidget'), {no_label: false, placeholder: 'https://...'}) }}
        </div>
        <div class="col-md-4">
            {{ fields.textField('value_path', '', __('JSON path to the value', 'urlwidget'), {no_label: false, placeholder: 'data.rows.0.0'}) }}
        </div>

        <div class="col-md-2">
            {{ fields.textField('value_prefix', '', __('Prefix', 'urlwidget'), {no_label: false}) }}
        </div>
        <div class="col-md-2">
            {{ fields.textField('value_suffix', '', __('Suffix', 'urlwidget'), {no_label: false}) }}
        </div>
        <div class="col-md-2">
            {{ fields.numberField('cache_ttl', 300, __('Cache (seconds)', 'urlwidget'), {no_label: false}) }}
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <label class="form-check">
                <input type="checkbox" class="form-check-input" name="verify_ssl" value="1" checked>
                <span class="form-check-label">{{ __('Verify SSL certificate', 'urlwidget') }}</span>
            </label>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" name="add" value="1" class="btn btn-primary">
                <i class="ti ti-plus"></i>
            </button>
        </div>
    </form>
    <p class="text-muted mt-2">
        {{ __('The Data URL is called from the GLPI server (not the browser). Its response can be plain text or JSON.', 'urlwidget') }}
    </p>
    <p class="text-muted mt-2">
        {{ __('For a Metabase public question, use the JSON API endpoint (/api/public/card/<uuid>/query), not the public HTML page \u2014 it returns the result directly as data, e.g. path "data.rows.0.0" for a single-value question.', 'urlwidget') }}
    </p>
    <p class="text-muted mt-2">
        {{ __('Once added, the URL becomes available as a dashboard card named after it, rendered like GLPI\'s native "big number" cards.', 'urlwidget') }}
    </p>
</div>
{% endif %}
